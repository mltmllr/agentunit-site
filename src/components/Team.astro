---
/**
 * Team-Abschnitt (Layout der alten team.html). `full`: komplette Karten mit
 * Beschreibung, Expertise und Values (Seite /team). Sonst kompakte Karten (Startseite).
 */
import { url } from '../config/site';
import type { Member } from '../config/team';

interface Props { members: Member[]; full?: boolean }
const { members, full = false } = Astro.props;
---

<div class:list={['team-grid', { 'team-grid-full': full }]}>
  {members.map((m, i) => (
    <article class:list={['agent-card', { 'agent-card-full': full }]}>
      <div class="agent-avatar">
        <img src={url(m.avatar)} alt={m.alt} width="140" height="140" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" />
      </div>
      <h3 class="agent-name">{m.name}</h3>
      <p class="agent-role">{m.role}</p>
      {full && (
        <>
          <p class="agent-tag"><span class="au-badge">{m.tag}</span></p>
          <p class="agent-desc">{m.description}</p>
          <dl class="agent-facts">
            <dt>Expertise</dt><dd>{m.expertise}</dd>
            <dt>Values</dt><dd>{m.values}</dd>
          </dl>
        </>
      )}
    </article>
  ))}
</div>
